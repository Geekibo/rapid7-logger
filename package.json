{
  "name": "@geekibo/rapid7-logger",
  "version": "0.0.0",
  "description": "Reliable Rapid7 InsightOps logging for Node.js and Next.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geekibo/rapid7-logger.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/next.js",
    "./dist/next.cjs"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./edge": {
      "import": {
        "types": "./dist/edge.d.ts",
        "default": "./dist/edge.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup",
    "test:next-build": "vitest run test/next-build",
    "test:next-app": "vitest run test/next-app"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "server-only": "*"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "server-only": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
