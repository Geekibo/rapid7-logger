# Live test credentials (test/live/, DESIGN §9.2). Copy to .env — which is gitignored — and
# point them at a DEDICATED log. Never commit a real value.
#
# The ingestion token is the GUID at the end of the log's webhook URL. It is a write credential.
RAPID7_LIVE_TOKEN=
# eu | us | au | ca | jp
RAPID7_LIVE_REGION=eu
# The log's id (not the token), used to read entries back through the Query API.
RAPID7_LIVE_LOG_ID=
# A read-only API key for the Query API — a different credential from the token.
RAPID7_QUERY_API_KEY=
